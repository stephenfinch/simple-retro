# ── Required ────────────────────────────────────────────────────────────────
# Postgres connection string. Neon URLs (…neon.tech…) use the Neon serverless driver automatically.
DATABASE_URL=postgres://localhost:5432/simple_retro
# Public URL of this app. Used for invite and retro links.
APP_URL=http://localhost:3000

# ── Optional: AI ────────────────────────────────────────────────────────────
# Set one key to turn on "Group for me", action ideas and the written summary.
# Leave both empty and the app works the same, without the AI buttons.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# With both keys set, Claude is used. Set AI_PROVIDER=gemini to use Gemini instead.
# AI_PROVIDER=
# Override the model. Defaults: claude-opus-5-5 (Claude), gemini-flash-latest (Gemini).
# AI_MODEL=

# ── Optional ────────────────────────────────────────────────────────────────
# Force a database driver: "neon" or "pg"
# DB_DRIVER=
